{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User",
  "type": "object",
  "required": [
    "id",
    "firstName",
    "lastName",
    "email",
    "username"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "maidenName": {
      "type": ["string", "null"]
    },
    "age": {
      "type": "integer"
    },
    "gender": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "deletedOn": {
      "type": "string"
    }
  }
}
