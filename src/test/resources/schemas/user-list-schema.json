{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserListResponse",
  "type": "object",
  "required": [
    "users",
    "total",
    "skip",
    "limit"
  ],
  "properties": {
    "users": {
      "type": "array",
      "items": {
        "$ref": "user-schema.json"
      }
    },
    "total": {
      "type": "integer"
    },
    "skip": {
      "type": "integer"
    },
    "limit": {
      "type": "integer"
    }
  }
}
