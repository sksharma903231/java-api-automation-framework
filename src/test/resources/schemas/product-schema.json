{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Product",
  "type": "object",
  "required": [
    "id",
    "title",
    "price",
    "category"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "discountPercentage": {
      "type": "number"
    },
    "rating": {
      "type": "number"
    },
    "stock": {
      "type": "integer"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "brand": {
      "type": ["string", "null"]
    },
    "sku": {
      "type": "string"
    },
    "isDeleted": {
      "type": "boolean"
    },
    "deletedOn": {
      "type": "string"
    }
  }
}
